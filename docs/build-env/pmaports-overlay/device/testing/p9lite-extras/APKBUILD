# Maintainer: Hamdan Radaideh <hamdan.radaideh2012@gmail.com>
pkgname=p9lite-extras
pkgdesc="P9 Lite homelab extras: LCD dashboard (p9-display), hisi wifi service, zram swap, status web page"
pkgver=1.0
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="noarch"
options="!check"
depends="python3 wpa_supplicant"
source="
	hisi-wifi.initd
	hisi-wifi.confd
	p9-display.initd
	p9-display.confd
	p9-display
	p9-verify
	zram-swap.start
	90-zram.conf
	90-hisi-wifi.conf
	99-unmanage-wlan0.conf
	p9-web-index.html
	p9-srv.start
	p9-nginx-default.conf
	"
builddir="$srcdir"

build() { :; }

package() {
	install -Dm755 "$srcdir"/hisi-wifi.initd "$pkgdir"/etc/init.d/hisi-wifi
	install -Dm644 "$srcdir"/hisi-wifi.confd "$pkgdir"/etc/conf.d/hisi-wifi
	install -Dm755 "$srcdir"/p9-display.initd "$pkgdir"/etc/init.d/p9-display
	install -Dm644 "$srcdir"/p9-display.confd "$pkgdir"/etc/conf.d/p9-display
	install -Dm755 "$srcdir"/p9-display "$pkgdir"/usr/bin/p9-display
	install -Dm755 "$srcdir"/p9-verify "$pkgdir"/usr/bin/p9-verify
	install -Dm755 "$srcdir"/zram-swap.start "$pkgdir"/etc/local.d/zram-swap.start
	install -Dm644 "$srcdir"/90-zram.conf "$pkgdir"/etc/sysctl.d/90-zram.conf
	install -Dm644 "$srcdir"/90-hisi-wifi.conf "$pkgdir"/etc/NetworkManager/conf.d/90-hisi-wifi.conf
	install -Dm644 "$srcdir"/99-unmanage-wlan0.conf "$pkgdir"/etc/NetworkManager/conf.d/99-unmanage-wlan0.conf
	install -Dm644 "$srcdir"/p9-web-index.html "$pkgdir"/usr/share/p9lite/web/index.html
	install -Dm644 "$srcdir"/p9-nginx-default.conf "$pkgdir"/usr/share/p9lite/web/default.conf
	install -Dm755 "$srcdir"/p9-srv.start "$pkgdir"/etc/local.d/p9-srv.start
	# enable services at boot
	mkdir -p "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/hisi-wifi "$pkgdir"/etc/runlevels/default/hisi-wifi
	ln -sf /etc/init.d/p9-display "$pkgdir"/etc/runlevels/default/p9-display
}
