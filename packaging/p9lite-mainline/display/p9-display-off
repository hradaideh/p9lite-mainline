#!/usr/bin/env python3
"""P9 lite, mainline: power the display path down (screen work on hold - saves power).
Mirrors the vendor 4.4 hisifb dpe_off order (k7/logs/iotrace-4.4-display-offon.txt):
LDI off, D-PHY off, DSI clocks off + DSI held in reset, panel rails off (hi6522 0x11: 06 -> 04 -> 00),
backlight boost off (hi6522 0x12 bit 2), DSS inner clocks off, LPM3 powers dsssubsys/mmbuf/vivobus
down (mailbox 14), DSS bus clocks and MMBUF off. Display registers are only touched while the CRG
reports the DSS bus clocks on, so a second run (or a run after it is already off) is harmless."""
import mmap, os, struct, subprocess, sys, time
fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
def mapw(base, n=0x1000):
    m = mmap.mmap(fd, n, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=base)
    return (lambda o: struct.unpack_from("<I", m, o)[0]), (lambda o, v: struct.pack_into("<I", m, o, v & 0xFFFFFFFF))
crg_r, crg_w = mapw(0xFFF35000)
sc_r, sc_w = mapw(0xFFF0A000)
def i2c(reg, val):
    subprocess.run(["i2cset", "-f", "-y", "0", "0x6b", hex(reg), hex(val)], check=False)
def i2c_get(reg):
    out = subprocess.run(["i2cget", "-f", "-y", "0", "0x6b", hex(reg)], capture_output=True, text=True).stdout
    return int(out, 16) if out.strip() else None

def lpm3(w0, w1):
    """HiIPCV230 mailbox 14 to LPM3 (src bit 1, dst bit 3, manual ack) - tools/p9lpm3.py."""
    r, w = mapw(0xE896B000)
    MB = 14 << 6
    w(0xA00, 0x1ACCE551)
    for _ in range(100):
        if r(MB + 0x10) & 0x10:
            w(MB, 1 << 1)
            if r(MB) & 2:
                break
        time.sleep(0.001)
    else:
        return False
    w(MB + 0x14, ~0); w(MB + 0x14, r(MB + 0x14) & ~0xA)
    w(MB + 0x04, 1 << 3); w(MB + 0x10, 0); w(MB + 0x20, w0); w(MB + 0x24, w1); w(MB + 0x1C, 1 << 1)
    t0 = time.time()
    while not r(MB + 0x10) & 0x80 and time.time() - t0 < 0.3:
        time.sleep(0.0005)
    ok = bool(r(MB + 0x10) & 0x80) and r(MB + 0x20) == w0
    w(MB + 0x18, 1 << 1); w(MB + 0x14, ~0); w(MB, 1 << 1)
    return ok

dss_on = (crg_r(0x3C) & 0x3000) == 0x3000          # PERSTAT3: pclk_dss + aclk_dss
if dss_on:
    dss_r, dss_w = mapw(0xE8600000, 0x80000)
    L = 0x7D000
    dss_w(L + 0x44, 1); dss_w(L + 0x24, dss_r(L + 0x24) & ~1)   # LDI: mask frames, off
    dss_w(0x10A0, 0)                                              # D-PHY: PHY_RSTZ = 0
    time.sleep(0.001)
crg_w(0x34, 1 << 29); crg_w(0x34, 1 << 28); crg_w(0x54, 1 << 28)  # D-PHY ref/cfg, pclk_dsi0 off
crg_w(0x84, 1 << 28)                                              # DSI0 held in reset
for v in (0x06, 0x04, 0x00):                                      # panel rails off, vendor order
    i2c(0x11, v); time.sleep(0.005)
bl = i2c_get(0x12)
if bl is not None:
    i2c(0x12, bl & ~0x04)                                         # backlight boost (wled_en) off
crg_w(0x34, 1 << 15); crg_w(0xF0, 0x00400000)                     # clk_ldi0 off
crg_w(0x34, 1 << 17); crg_w(0xF0, 0x01000000)                     # clk_edc0 off
down = [lpm3(0xC0101, d) for d in (0x0B, 0x09, 0x0A)]             # dsssubsys, mmbuf, vivobus off
crg_w(0x34, 1 << 12); crg_w(0x34, 1 << 13)                        # pclk/aclk_dss off
sc_w(0x174, 1 << 24)                                              # SCPERDIS1: MMBUF clock off
print("display off: DSS was %s, LPM3 dsssubsys/mmbuf/vivobus off acks %s, hi6522 0x11=%s 0x12=%s" % (
    "on" if dss_on else "already off", down, hex(i2c_get(0x11) or 0), hex(i2c_get(0x12) or 0)))
