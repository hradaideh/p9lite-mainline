}

class Canvas:
    def __init__(self): self.c = bytearray(LW * LH)
    def clear(self): self.c[:] = bytes(LW * LH)
    def rect(self, x, y, w, h, col):
        for yy in range(max(0, y), min(LH, y + h)):
            o = yy * LW
            x0, x1 = max(0, x), min(LW, x + w)
            if x1 > x0: self.c[o + x0:o + x1] = bytes((col,)) * (x1 - x0)
    def text(self, x, y, s, col=1, scale=1):
        for ch in s.upper():
            g = F.get(ch, F['*'])
            for ry, row in enumerate(g):
                for rx, bit in enumerate(row):
                    if bit == '1': self.rect(x + rx * scale, y + ry * scale, scale, scale, col)
            x += 6 * scale
        return x
    def bar(self, x, y, w, h, frac, col):
        frac = max(0.0, min(1.0, frac))
        self.rect(x, y, w, h, 7)
        self.rect(x, y, int(w * frac), h, col)
    def frame(self):
        out = []
        for ly in range(LH):
            o = ly * LW
            row = b''.join(PXROW[i] for i in self.c[o:o + LW])
            out.append(row * S)
        return b''.join(out)

def rd(p, d=''):
    try:
        with open(p) as f: return f.read().strip()
    except OSError: return d

_cpu = None
def cpu_pct():
    global _cpu
    v = [int(x) for x in rd('/proc/stat').split('\n')[0].split()[1:8]]
    busy, total = v[0] + v[1] + v[2] + v[5] + v[6], sum(v)
    pct = 0.0
    if _cpu and total > _cpu[1]: pct = 100.0 * (busy - _cpu[0]) / (total - _cpu[1])
    _cpu = (busy, total)
    return pct

def meminfo():
    m = {}
    for l in rd('/proc/meminfo').split('\n'):
        k, v = l.split(':'); m[k] = int(v.split()[0]) // 1024
    return m

def http_ok(url):
    try: return urllib.request.urlopen(url, timeout=3).status == 200
    except Exception: return False

def ip_of(ifn):
    try:
        out = subprocess.run(['ip', '-4', '-o', 'addr', 'show', ifn], capture_output=True, text=True, timeout=3).stdout
        return out.split()[3].split('/')[0]
    except Exception: return '-'

def wifi():
    try:
        st = subprocess.run(['wpa_cli', '-i', 'wlan0', 'status'], capture_output=True, text=True, timeout=3).stdout
        sp = subprocess.run(['wpa_cli', '-i', 'wlan0', 'signal_poll'], capture_output=True, text=True, timeout=3).stdout
        d = dict(l.split('=', 1) for l in (st + sp).split('\n') if '=' in l)
        return d.get('ssid', '-'), d.get('RSSI', '?'), d.get('wpa_state', '?')
    except Exception: return '-', '?', '?'

def usb_ip():
    for ifn in ('usb0', 'rndis0'):
        ip = ip_of(ifn)
        if ip != '-': return ip
    return '-'

def mesh():
    """Cloudflare Mesh (WARP connector) gateway state from the mesh container."""
    d = {'container': MESH_CT, 'status': 'DOWN', 'network': '-', 'ip': ip_of('CloudflareWARP'),
         'routes': MESH_ROUTES, 'up': False}
    try:
        out = subprocess.run(['docker', 'exec', MESH_CT, 'warp-cli', '--accept-tos', 'status'],
                             capture_output=True, text=True, timeout=8).stdout
        for l in out.split('\n'):
            if l.startswith('Status update:'): d['status'] = l.split(':', 1)[1].strip().upper()
            if l.startswith('Network:'): d['network'] = l.split(':', 1)[1].strip().upper()
    except Exception:
        pass
    d['up'] = d['status'] == 'CONNECTED'
    return d

def battery():
    """power_supply class (vendor kernel) or the p9test Hi6555 gauge readout (mainline)."""
    if os.path.isdir('/sys/class/power_supply/Battery'):
        bat = rd('/sys/class/power_supply/Battery/capacity', '?')
        bst = rd('/sys/class/power_supply/Battery/status', '?').upper()
        ext = rd('/sys/class/power_supply/USB/online', '0') == '1' or rd('/sys/class/power_supply/Mains/online', '0') == '1'
        try: cur = abs(int(rd('/sys/class/power_supply/Battery/current_now', '0')))
        except ValueError: cur = 0
        try: temp = int(rd('/sys/class/power_supply/Battery/temp', '0') or 0) / 10
        except ValueError: temp = None
        return (int(bat) if bat.isdigit() else None), bst, ext, cur, temp, None
    try:
        uv, ua = (int(x) for x in rd('/sys/module/p9test/parameters/battery').split()[:2])
    except Exception:
        return None, '?', False, 0, None, None
    mv = uv // 1000
    pct = max(0, min(100, round((mv - 3400) * 100 / (4390 - 3400))))   # rough Li-ion curve; full = 4.39 V
    ma = -(ua // 1000)                    # Hi6555 gauge: positive = discharging -> make charging positive
    try:   # hi6522 STATUS0 bits 5-6 (chg_chgstate): 0 idle, 1 pre-charge, 2 fast charge, 3 done
        st = (int(subprocess.run(['i2cget', '-f', '-y', '0', '0x6b', '0x01'], capture_output=True,
                                 text=True, timeout=3).stdout, 16) >> 5) & 3
    except Exception:
        st = None
    if st in (1, 2) and ma > 0: bst = 'CHARGING'
    elif ma < -20: bst = 'DISCHARGING'
    else: bst = 'IDLE (80% LIMIT)' if mv >= 4080 else 'IDLE'
    try:   # battery NTC via LPM3 HKADC (p9-hkadc, /dev/mem mailbox); None if LPM3 does not answer
        temp = float(subprocess.run(['/usr/local/bin/p9-hkadc'], capture_output=True, text=True, timeout=5).stdout)
    except Exception:
        temp = None
    return pct, bst, ma > -20, abs(ma), temp, mv

CHG_STATES = {0: 'Idle', 1: 'Pre-charge', 2: 'Fast charge', 3: 'Done'}

def charger():
    """p9-charger status (/run/p9-charger.json) + the supervised discharge (tools/p9-discharge.py) if any."""
    try:
        c = json.loads(rd('/run/p9-charger.json', '{}') or '{}')
    except ValueError:
        c = {}
    log = [l for l in rd('/var/log/p9-discharge.log', '').splitlines() if l.strip()]
    running = subprocess.run(['pgrep', '-f', 'p9-discharge.py'], capture_output=True).returncode == 0
    svc = os.path.exists('/run/p9-charger.pid') and os.path.exists('/proc/' + rd('/run/p9-charger.pid', 'x').strip())
    return {'limit_pct': 80, 'cv_mv': c.get('cv_mv'), 'state': CHG_STATES.get(c.get('chg_state'), '?'),
            'service': svc, 'checked': c.get('time'),
            'discharge': {'running': running, 'last': log[-1][20:] if log else None}}

def disk(path='/'):
    """(used, usable) GB like df: ext4's reserved blocks count as neither used nor available."""
    s = os.statvfs(path)
    used = (s.f_blocks - s.f_bfree) * s.f_frsize / 2**30
    return used, used + s.f_bavail * s.f_frsize / 2**30

def sd_disk():
    """(used, total) GB of the microSD data mount, or None when it is not mounted."""
    if not os.path.ismount(SD_MNT): return None
    try: return disk(SD_MNT)
    except OSError: return None

def tcp_ok(port, host='127.0.0.1'):
    try:
        with socket.create_connection((host, port), timeout=3): return True
    except OSError: return False

def uptime():
    u = int(float(rd('/proc/uptime', '0').split()[0]))
    d, r = divmod(u, 86400); h, r = divmod(r, 3600); m = r // 60
    return (f'{d}D ' if d else '') + f'{h}H {m:02d}M'

def render(cv, tick):
    cv.clear()
    dx = tick % 3   # tiny pixel-shift each refresh (anti burn-in)
    y = 6
    cv.text(4 + dx, y, socket.gethostname()[:14], 6, 2); y += 20
    cv.text(4 + dx, y, time.strftime('%H:%M'), 1, 4); y += 32
    cv.text(4 + dx, y, time.strftime('%a %d %b') + '  UP ' + uptime(), 2); y += 14

    cv.rect(4, y, LW - 8, 1, 7); y += 6
    ssid, rssi, st = wifi()
    cv.text(4 + dx, y, 'WIFI', 2); cv.text(40 + dx, y, f'{ssid} {rssi}DBM', 3 if st == 'COMPLETED' else 4); y += 11
    cv.text(4 + dx, y, 'IP', 2); cv.text(40 + dx, y, ip_of('wlan0'), 1); y += 11
    cv.text(4 + dx, y, 'USB', 2); cv.text(40 + dx, y, usb_ip(), 1); y += 11
    mg = mesh()
    cv.text(4 + dx, y, 'MESH', 2); cv.text(40 + dx, y, (mg['ip'] + ' ' + ('OK' if mg['up'] else mg['status']))[:23], 3 if mg['up'] else 4); y += 14

    cv.rect(4, y, LW - 8, 1, 7); y += 6
    c = cpu_pct(); m = meminfo()
    used = m['MemTotal'] - m['MemAvailable']; sw = m['SwapTotal'] - m['SwapFree']
    du, dt = disk()
    sd = sd_disk()
    tz = rd('/sys/class/thermal/thermal_zone0/temp', '')
    t = int(tz) / 1000 if tz.lstrip('-').isdigit() else None
    bpct, bst, ext, cur, btemp, bmv = battery()
    bat = str(bpct) if bpct is not None else '?'
    chg = charger()
    if bst == 'CHARGING': blabel, bcol = 'CHARGING', 3
    elif chg['discharge']['running']: blabel, bcol = 'DISCHARGING TO 80%', None
    elif bst.startswith('IDLE (80%'): blabel, bcol = 'AT 80% LIMIT', 3
    elif ext and bst != 'DISCHARGING': blabel, bcol = 'PLUGGED', 3
    else: blabel, bcol = 'ON BATTERY', None
    bval = f'{bat}% {blabel} {cur}MA' if len(f'{bat}% {blabel} {cur}MA') <= 23 else f'{bat}% {blabel}'
    if bmv: bval = f'{bmv}MV {blabel}'[:23]
    info = {'hostname': socket.gethostname(), 'time': time.strftime('%Y-%m-%dT%H:%M:%S%z'),
            'uptime': uptime(), 'uptime_s': int(float(rd('/proc/uptime', '0').split()[0])),
            'wifi': {'ssid': ssid, 'rssi_dbm': rssi, 'state': st, 'ip': ip_of('wlan0')},
            'usb_ip': usb_ip(),
            'mesh': mg,
            'cpu_pct': round(c, 1),
            'ram_mb': {'used': used, 'total': m['MemTotal']},
            'swap_mb': {'used': sw, 'total': m['SwapTotal']},
            'disk_gb': {'used': round(du, 2), 'total': round(dt, 2)},
            'sd_gb': ({'used': round(sd[0], 2), 'total': round(sd[1], 2), 'mount': SD_MNT, 'mounted': True}
                      if sd else {'used': None, 'total': None, 'mount': SD_MNT, 'mounted': False}),
            'soc_temp_c': round(t, 1) if t is not None else None,
            'battery': {'pct': int(bat) if bat.isdigit() else None, 'status': bst,
                        'state': blabel, 'external_power': ext, 'current_ma': cur,
                        'temp_c': btemp, 'voltage_mv': bmv},
            'charger': chg,
            'screen': 'off (on hold)' if os.environ.get('P9_DSS', '1') != '1' and not os.path.exists('/dev/fb0') else 'on',
            'services': {}}
    rows = [('CPU', f'{c:4.1f}%', c / 100),
            ('RAM', f'{used}/{m["MemTotal"]}M', used / m['MemTotal']),
            ('SWAP', f'{sw}/{m["SwapTotal"]}M', sw / max(1, m['SwapTotal'])),
            ('DISK', f'{du:.1f}/{dt:.1f}G', du / dt),
            ('SD', f'{sd[0]:.1f}/{sd[1]:.0f}G' if sd else 'NOT MOUNTED', sd[0] / sd[1] if sd else 1.0),
            ('SOC', f'{t:.0f}C' if t is not None else 'N/A', (t or 0) / 90),
            ('BATT', bval, int(bat) / 100 if bat.isdigit() else 0)]
    for name, val, frac in rows:
        col = 3 if frac < 0.7 else (5 if frac < 0.9 else 4)
        if name == 'BATT': col = bcol or (5 if frac > 0.3 else 4)
        if name == 'SD' and not sd: col = 4
        cv.text(4 + dx, y, name, 2); cv.text(40 + dx, y, val, 1 if name != 'SD' or sd else 4); y += 9
        cv.bar(4, y, LW - 8, 3, frac, col); y += 6

    y += 2; cv.rect(4, y, LW - 8, 1, 7); y += 6
    cv.text(4 + dx, y, 'SERVICES', 6); y += 11
    for name, url in (('NGINX :8080', 'http://127.0.0.1:8080/'),
                      ('HOME ASSIST :8123', 'http://127.0.0.1:8123/manifest.json')):
        ok = http_ok(url)
        info['services'][name.split(' :')[0].lower().replace(' ', '_')] = {'up': ok, 'port': int(name.rsplit(':', 1)[1])}
        cv.rect(4 + dx, y, 6, 7, 3 if ok else 4)
        cv.text(14 + dx, y, name, 1); cv.text(LW - 22 + dx, y, 'UP' if ok else 'DN', 3 if ok else 4); y += 11
    web, ssh = http_ok('http://127.0.0.1:3000/api/healthz'), tcp_ok(2222)
    info['services']['forgejo'] = {'up': web, 'port': 3000}
    info['services']['forgejo_ssh'] = {'up': ssh, 'port': 2222}
    ok = web and ssh
    cv.rect(4 + dx, y, 6, 7, 3 if ok else (5 if web or ssh else 4))
    cv.text(14 + dx, y, 'FORGEJO :3000/2222', 1); cv.text(LW - 22 + dx, y, 'UP' if ok else 'DN', 3 if ok else 4); y += 11
    ok = mg['up']
    info['services']['mesh'] = {'up': ok, 'port': None}
    cv.rect(4 + dx, y, 6, 7, 3 if ok else 4)
    cv.text(14 + dx, y, 'CF MESH GATEWAY', 1); cv.text(LW - 22 + dx, y, 'UP' if ok else 'DN', 3 if ok else 4); y += 11
    cv.text(4 + dx, LH - 10, 'UPDATED ' + time.strftime('%H:%M:%S'), 2)
    return info

def png(cv):
    """Logical canvas -> indexed 8-bit PNG (stdlib only)."""
    import zlib
    def chunk(t, d): return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    raw = b''.join(b'\x00' + bytes(cv.c[y * LW:(y + 1) * LW]) for y in range(LH))
    plte = b''.join(bytes((p[2], p[1], p[0])) for p in PAL)
    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', LW, LH, 8, 3, 0, 0, 0))
            + chunk(b'PLTE', plte) + chunk(b'IDAT', zlib.compress(raw, 9)) + chunk(b'IEND', b''))

def publish(info, cv):
    """Write status.json + screen.png for nginx (atomic rename)."""
    import json
    if not WEB_DIR or not os.path.isdir(WEB_DIR): return
    for name, data in (('status.json', json.dumps(info, indent=1).encode()), ('screen.png', png(cv))):
        tmp = os.path.join(WEB_DIR, '.' + name + '.tmp')
        with open(tmp, 'wb') as f: f.write(data)
        os.chmod(tmp, 0o644); os.replace(tmp, os.path.join(WEB_DIR, name))

def open_display():
    """Return (show(buf), close(), name)."""
    if os.path.exists('/dev/fb0'):
        fd = os.open('/dev/fb0', os.O_RDWR)        # powers the panel on (hisifb)
        mm = mmap.mmap(fd, STRIDE * H, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
        vinfo = bytearray(160); fcntl.ioctl(fd, 0x4600, vinfo)   # FBIOGET_VSCREENINFO
        struct.pack_into('II', vinfo, 16, 0, 0)                   # xoffset, yoffset = 0
        def show(buf):
            mm.seek(0); mm.write(buf)
            fcntl.ioctl(fd, 0x4606, vinfo)                         # FBIOPAN_DISPLAY -> push frame
        def close(): mm.close(); os.close(fd)
        return show, close, 'fb0'
    if os.environ.get('P9_DSS', '1') == '1':
        try:
            fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)
            regs = mmap.mmap(fd, 0x80000, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=DSS_BASE)
            r = lambda o: struct.unpack_from('<I', regs, o)[0]
            # only if the bootloader left RCH_D0 scanning out the 1080-wide buffer
            if r(0x50060) == DSS_FB and r(0x60000) == 0x077f0437:
                mm = mmap.mmap(fd, STRIDE * H, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=DSS_FB)
                L = 0x7D000
                def show(buf):
                    mm[:len(buf)] = buf
                    struct.pack_into('<I', regs, L + 0x48, r(L + 0x48) | 1)   # LDI_FRM_MSK_UP
                    struct.pack_into('<I', regs, L + 0x24, r(L + 0x24) | 1)   # LDI_CTRL: one frame
                def close(): mm.close(); regs.close(); os.close(fd)
                return show, close, 'dss'
            regs.close(); os.close(fd)
        except OSError as e:
            print('dss backend unavailable:', e, flush=True)
    return (lambda buf: None), (lambda: None), 'headless'

def main():
    show, close, backend = open_display()
    print('p9-display backend:', backend, flush=True)
    def bl(v):
        try: open(BL, 'w').write(str(v))
        except OSError: pass
    def stop(*_):
        show(bytes(STRIDE * H)); bl(0); close(); sys.exit(0)
    signal.signal(signal.SIGTERM, stop); signal.signal(signal.SIGINT, stop)
    cv = Canvas(); cpu_pct(); tick = 0
    while True:
        info = render(cv, tick)
        show(cv.frame())
        try: publish(info, cv)
        except Exception as e: print('publish failed:', e, flush=True)
        if tick == 0: bl(BRIGHTNESS)
        tick += 1
        time.sleep(INTERVAL)

if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == '--png-test':
        cv = Canvas(); cpu_pct(); time.sleep(0.2); render(cv, 0)
        # dump logical canvas as PGM-like PPM for offline preview
        rgb = [(p[2], p[1], p[0]) for p in PAL]
        with open(sys.argv[2], 'wb') as f:
            f.write(b'P6 %d %d 255\n' % (LW, LH))
            f.write(b''.join(bytes(rgb[i]) for i in cv.c))
        sys.exit(0)
    main()
