#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
# Read a HiSilicon HKADC channel on the P9 lite (hi6250) by asking LPM3 over the HiIPCV230
# mailbox at 0xe896b000, as the vendor hisi_adc driver does. Default: channel 10, battery NTC,
# converted with the device tree's coul_core/ntc_table. Needs root and /dev/mem.
#   p9hkadc.py            battery temperature
#   p9hkadc.py --probe    read-only register dump, writes nothing
#   p9hkadc.py --chan N   raw code + mV for channel N
import ctypes, mmap, os, struct, sys, time

IPC = 0xE896B000
KEY = 0x1ACCE551
TX, RX = 16, 0                 # mailbox-16: AP(src bit 0) -> LPM3(bit 3); mailbox-0: LPM3 -> AP
SRC, DES = 0, 3
IDLE, ACK = 1 << 4, 1 << 7
AUTO_ACK = 1
HDR_TX = 0x000B020C
HDR_RX = 0x080B020C
T_DEG = [-273, -40, -36, -32, -28, -24, -20, -16, -12, -8, -4, 0, 4, 8, 12, 16, 20, 24, 28, 32,
         36, 40, 44, 48, 52, 56, 60, 64, 74, 84, 125]


def mb(m, off): return (m << 6) + off


class Ipc:
    def __init__(s):
        s.fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)
        s.m = mmap.mmap(s.fd, 0x1000, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=IPC)

    # Single 32-bit accesses only: the APB bus faults (SIGBUS) on the byte copies struct does.
    def r(s, o): return ctypes.c_uint32.from_buffer(s.m, o).value
    def w(s, o, v): ctypes.c_uint32.from_buffer(s.m, o).value = v & 0xFFFFFFFF

    def dump(s, m):
        # DSET, DCLR and SEND are write-only: reading them faults
        names = (('SRC', 0x00), ('DSTAT', 0x0C), ('MODE', 0x10), ('IMASK', 0x14), ('ISTAT', 0x18))
        regs = ' '.join('%s=%#x' % (n, s.r(mb(m, o))) for n, o in names)
        data = ' '.join('%#x' % s.r(mb(m, 0x20 + i * 4)) for i in range(8))
        print('mbox%-2d %s | data %s' % (m, regs, data))

    def xfer(s, chan, timeout=1.5):
        s.w(0xA00, KEY)                                  # unlock
        if s.r(0xA00) != 0: sys.exit('IPC stays locked')
        if not s.r(mb(TX, 0x10)) & IDLE: sys.exit('mailbox %d busy: MODE=%#x' % (TX, s.r(mb(TX, 0x10))))
        s.w(mb(TX, 0x00), 1 << SRC)                      # occupy
        if not s.r(mb(TX, 0x00)) & (1 << SRC): sys.exit('could not occupy mailbox %d' % TX)
        stale = s.r(mb(RX, 0x20))
        try:
            s.w(mb(TX, 0x14), 0xFFFFFFFF)                # mask all, then unmask destination
            s.w(mb(TX, 0x14), s.r(mb(TX, 0x14)) & ~(1 << DES))
            s.w(mb(TX, 0x04), 1 << DES)                  # destination = LPM3
            s.w(mb(TX, 0x10), AUTO_ACK)
            s.w(mb(TX, 0x20), HDR_TX); s.w(mb(TX, 0x24), chan)
            s.w(mb(TX, 0x1C), 1 << SRC)                  # send
            end = time.time() + timeout
            while time.time() < end:
                h, d = s.r(mb(RX, 0x20)), s.r(mb(RX, 0x24))
                if h == HDR_RX and (d & 0xFF) == chan and not (stale == HDR_RX and d == getattr(s, 'last', None)):
                    s.last = d
                    err = (d >> 8) & 0xFF
                    s.rx_ack()
                    return None if err else d >> 16
                time.sleep(0.002)
            return None
        finally:
            s.w(mb(TX, 0x14), 0xFFFFFFFF)                # release: mask all, give the source back
            s.w(mb(TX, 0x00), 1 << SRC)

    def rx_ack(s):
        # vendor hisi_mdev_clr_irq_and_ack: zero the data, clear the AP's interrupt bits, ack if manual
        for i in range(8): s.w(mb(RX, 0x20 + i * 4), 0)
        todo = ((1 << 0) | (1 << 1)) & ~s.r(mb(RX, 0x14))   # GIC_1 = bit 0, GIC_2 = bit 1
        s.w(mb(RX, 0x18), todo)
        st = s.r(mb(RX, 0x10))
        if st & (1 << 6) and not st & AUTO_ACK: s.w(mb(RX, 0x1C), todo)


def ntc():
    d = open('/proc/device-tree/coul_core/ntc_table', 'rb').read()
    v = struct.unpack('>%dI' % (len(d) // 4), d)[:len(T_DEG)]
    return list(zip(T_DEG, v))


def code_to_c(code, tab):
    if code >= tab[0][1]: return float(tab[0][0])
    if code <= tab[-1][1]: return float(tab[-1][0])
    for i in range(1, len(tab)):
        (t0, v0), (t1, v1) = tab[i - 1], tab[i]
        if code >= v1:
            return t0 + (code - v0) * (t1 - t0) / (v1 - v0)


def main():
    a = sys.argv[1:]
    ipc = Ipc()
    if '--probe' in a:
        print('lock=%#x' % ipc.r(0xA00))
        for m in (RX, TX): ipc.dump(m)
        return
    chan = int(a[a.index('--chan') + 1]) if '--chan' in a else 10
    code = None
    for _ in range(3):
        code = ipc.xfer(chan)
        if code is not None: break
    if code is None: sys.exit('no answer from LPM3 on channel %d' % chan)
    mv = code * 1800 // 0xFFF
    if chan == 10 and '--chan' not in a:
        print('%.1f' % code_to_c(code, ntc()))
    else:
        print('chan=%d code=%d mv=%d' % (chan, code, mv))


if __name__ == '__main__':
    main()
