# Maintainer: hradaideh <hradaideh@users.noreply.github.com>
# Device-side configuration for running linux-huawei-venus-mainline under postmarketOS.
pkgname=p9lite-mainline
pkgver=1
pkgrel=2
pkgdesc="Huawei P9 lite mainline-kernel config: boot cmdline, boot_ok signal, Hi1102 init, HA firewall rule, Cloudflare Mesh forwarding/NAT"
arch="noarch"
url="https://github.com/hradaideh/p9lite-mainline"
license="MIT"
depends="linux-huawei-venus-mainline"
options="!check"
# ships /etc/init.d/hisi-wifi on purpose (one small device package, no -openrc split)
source="deviceinfo p9-boot-ok.start hisi-wifi 60_homeassistant.nft 70_mesh.nft"

package() {
	install -Dm644 "$srcdir"/deviceinfo "$pkgdir"/etc/deviceinfo
	install -Dm755 "$srcdir"/p9-boot-ok.start "$pkgdir"/etc/local.d/p9-boot-ok.start
	install -Dm755 "$srcdir"/hisi-wifi "$pkgdir"/etc/init.d/hisi-wifi
	install -Dm644 "$srcdir"/60_homeassistant.nft "$pkgdir"/etc/nftables.d/60_homeassistant.nft
	install -Dm644 "$srcdir"/70_mesh.nft "$pkgdir"/etc/nftables.d/70_mesh.nft
}
